# Kopieren nach .env und anpassen. Danach: docker compose up -d

# Adresse, unter der die App im Heimnetz erreichbar ist (für Links in E-Mails)
APP_URL=http://192.168.1.10:8080

# E-Mail-Versand (Passwort vergessen, Einladungen)
SMTP_HOST=smtp.example.de
SMTP_PORT=587
# starttls (Port 587), ssl (Port 465) oder none
SMTP_SECURITY=starttls
SMTP_USER=benutzer@example.de
SMTP_PASSWORD=geheim
SMTP_FROM=Nebenkosten <benutzer@example.de>
